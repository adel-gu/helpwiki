<div class="sticky top-0 z-10 border-b border-base-200">
  <div class="mx-auto max-w-4xl px-4">
    <div class="flex items-center gap-1 py-2">
      <!-- Undo/Redo group-->
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom" data-tip="Undo" aria-label="Undo">
        <span class="material-symbols-outlined">undo</span>
      </button>
      <button class="btn btn-ghost btn-square btn-sm text-base-300 tooltip tooltip-bottom" data-tip="Redo" aria-label="Redo" disabled>
        <span class="material-symbols-outlined">redo</span>
      </button>

      <div class="divider divider-horizontal divider-base mx-2"></div>

      <!--Heading Group-->
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom" data-tip="Heading 1" aria-label="Heading 1">
        <span class="material-symbols-outlined">format_h1</span>
      </button>
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom" data-tip="Heading 2" aria-label="Heading 2">
        <span class="material-symbols-outlined">format_h2</span>
      </button>
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom" data-tip="Heading 3" aria-label="Heading 3">
        <span class="material-symbols-outlined">format_h3</span>
      </button>

      <div class="divider divider-horizontal mx-2"></div>

      <!-- Lists group -->
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom" data-tip="Bullet list" aria-label="Bullet list">
        <span class="material-symbols-outlined">format_list_bulleted</span>
      </button>
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom" data-tip="Ordered list" aria-label="Ordered list">
        <span class="material-symbols-outlined">format_list_numbered</span>
      </button>
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom" data-tip="Check list" aria-label="Check list">
        <span class="material-symbols-outlined">checklist</span>
      </button>

      <div class="divider divider-horizontal mx-2"></div>

      <!-- Formatting group -->
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom" data-tip="Bold" aria-label="Bold">
        <span class="material-symbols-outlined">format_bold</span>
      </button>
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom"
      data-tip="Italic" aria-label="Italic">
        <span class="material-symbols-outlined">format_italic</span>
      </button>
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom"
      data-tip="Strikethrough" aria-label="Strikethrough">
        <span class="material-symbols-outlined">strikethrough_s</span>
      </button>
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom"
      data-tip="Code" aria-label="Code">
        <span class="material-symbols-outlined">code</span>
      </button>
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom"
      data-tip="Underline" aria-label="Underline">
        <span class="material-symbols-outlined">format_underlined</span>
      </button>
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom"
      data-tip="Link" aria-label="Link">
        <span class="material-symbols-outlined">link</span>
      </button>

      <div class="divider divider-horizontal mx-2"></div>

      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom" data-tip="Superscript" aria-label="Superscript">
        <span class="material-symbols-outlined">superscript</span>
      </button>
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom" data-tip="Subscript" aria-label="Subscript">
        <span class="material-symbols-outlined">subscript</span>
      </button>

      <div class="divider divider-horizontal mx-2"></div>

      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom" data-tip="Align left" aria-label="Align left">
        <span class="material-symbols-outlined">format_align_left</span>
      </button>
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom" data-tip="Align center" aria-label="Align center">
        <span class="material-symbols-outlined">format_align_center</span>
      </button>
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom" data-tip="Align right" aria-label="Align right">
        <span class="material-symbols-outlined">format_align_right</span>
      </button>
      <button class="btn btn-ghost btn-square btn-sm text-secondary rounded-xl tooltip tooltip-bottom" data-tip="Align justify" aria-label="Align justify">
        <span class="material-symbols-outlined">format_align_justify</span>
      </button>

      <div class="divider divider-horizontal mx-2"></div>

      <button class="btn btn-ghost btn-sm text-secondary rounded-xl tooltip tooltip-bottom px-2" aria-label="Add image">
        <span class="material-symbols-outlined">add_photo_alternate</span>
        <span>Add</span>
      </button>

    </div>
  </div>
</div>
