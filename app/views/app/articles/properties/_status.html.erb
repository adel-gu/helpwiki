<%
  badge_class = case article.status
    when 'published' then 'badge-success text-success-content'
    when 'in_review' then 'badge-warning text-warning-content'
    when 'archived'  then 'badge-neutral text-neutral-content'
    when 'draft'     then 'badge-info'
    else 'badge-ghost'
  end
%>

<%# --- Column 1: Label --- %>
<div class="flex items-center gap-2 text-base-content/60 py-1.5">
  <span class="material-symbols-outlined text-[18px]">dataset</span>
  <span>Status</span>
</div>

<%# --- Column 2: Value --- %>
<div class="relative group hover:bg-base-200 rounded px-1 -ml-1 transition-colors h-8 flex items-center">

  <%# A. The Visual Layer (Badge) %>
  <div class="badge <%= badge_class %>  gap-1 border-0 font-medium">
    <span class="size-1.5 rounded-full bg-current opacity-60"></span>
    <%= article.status.humanize %>
  </div>

  <%# B. The Functional Layer (Invisible Select) %>
  <%= form.select :status,
      Article.statuses.keys.map { |k| [k.humanize, k] },
      {},
      class: "select select-ghost absolute inset-0 w-full h-full opacity-0 cursor-pointer",
      onchange: "this.form.requestSubmit();" %>
</div>