<div class="drawer drawer-end">
  <input id="my-drawer-5" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content">
    <!-- Page content here -->
    <label for="my-drawer-5" class="drawer-button btn btn-ghost btn-circle">
      <span class="material-symbols-outlined">apps</span>
    </label>
  </div>
  <div class="drawer-side">
    <label for="my-drawer-5" aria-label="close sidebar" class="drawer-overlay ">

    </label>
    <div class="bg-base-200 min-h-full w-1/2 p-4">
      <!-- Sidebar content here -->
      <div class="tabs tabs-border">
        <%= render "task_context", article: article %>

        <%= render "article_properties", article: article %>

        <%= render "versions" %>
      </div>
    </div>
  </div>
</div>