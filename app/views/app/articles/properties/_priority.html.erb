<%
  # Check if a value is actually set
  has_priority = article.priority.present?

  # Only determine badge color if we have a priority
  badge_class = case article.priority
    when 'high'   then 'badge-error text-error-content'
    when 'medium' then 'badge-warning text-warning-content'
    when 'low'    then 'badge-ghost text-base-content'
    else ''
  end
%>

<%# --- Column 1: Label --- %>
<div class="flex items-center gap-2 text-base-content/60 py-1.5">
  <span class="material-symbols-outlined text-[18px]">flag</span>
  <span>Priority</span>
</div>

<%# --- Column 2: Value --- %>
<div class="relative group hover:bg-base-200 rounded px-1 -ml-1 transition-colors h-8 flex items-center">

  <%# Toggle between Badge and Placeholder %>
  <% if has_priority %>

    <%# The Value (Badge) %>
    <div class="badge <%= badge_class %> gap-1 border-0 font-medium">
      <span class="size-1.5 rounded-full bg-current opacity-60"></span>
      <%= article.priority.humanize %>
    </div>

  <% else %>

    <span class="text-base-content/40 pl-1 select-none">
      Empty
    </span>

  <% end %>

  <%# B. The Functional Layer (Invisible Select) %>
  <%= form.select :priority,
      Article.priorities.keys.map { |k| [k.humanize, k] },
      { include_blank: "Empty" },
      class: "select select-ghost absolute inset-0 w-full h-full opacity-0 cursor-pointer",
      onchange: "this.form.requestSubmit();" %>

</div>