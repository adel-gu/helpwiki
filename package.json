{
  "name": "app",
  "private": true,
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "daisyui": "^5.3.10",
    "esbuild": "^0.25.11",
    "lodash.debounce": "^4.0.8"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
