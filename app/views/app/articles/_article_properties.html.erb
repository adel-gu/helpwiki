<input type="radio" name="article_metadata" role="tab" class="tab" aria-label="Properties" checked />
<div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6">

  <%= form_with model: article,
      url: app_article_path(article),
      method: :patch,
      class: "space-y-1",
      data: { controller: "autosave", action: "change->autosave#submit" } do |form| %>

    <!-- GRID CONTAINER -->
    <div class="grid grid-cols-[140px_1fr] items-center gap-y-1 text-sm">

      <%# --- 1. STATUS (Enum) --- %>
      <%= render "app/articles/properties/status", form: form, article: article %>

      <%# --- 2. PRIORITY (Enum) --- %>
      <%= render "app/articles/properties/priority", form: form, article: article %>

      <%# --- 3. REVIEWER (User Association) --- %>
      <div class="flex items-center gap-2 text-base-content/60 py-1.5">
        <span class="material-symbols-outlined text-[18px]">person_check</span>
        <span>Reviewer</span>
      </div>
      <div class="hover:bg-base-200 rounded px-1 -ml-1 transition-colors">
        <%# Assuming User has a 'name' attribute %>
        <%= form.collection_select :reviewer_id,
            User.all, :id, :full_name,
            { include_blank: "Empty" },
            class: "select select-ghost select-xs w-full font-normal focus:bg-base-200 focus:outline-none h-8 min-h-0 pl-1" %>
      </div>

      <%# --- 4. CATEGORY (Association) --- %>
      <div class="flex items-center gap-2 text-base-content/60 py-1.5">
        <span class="material-symbols-outlined text-[18px]">category</span>
        <span>Category</span>
      </div>
      <div class="hover:bg-base-200 rounded px-1 -ml-1 transition-colors">
        <%= form.collection_select :category_id,
            Category.all, :id, :name,
            { include_blank: "No Category" },
            class: "select select-ghost select-xs w-full font-normal focus:bg-base-200 focus:outline-none h-8 min-h-0 pl-1" %>
      </div>

      <%# --- 5. DUE DATE --- %>
      <div class="flex items-center gap-2 text-base-content/60 py-1.5">
        <span class="material-symbols-outlined text-[18px]">calendar_today</span>
        <span>Due Date</span>
      </div>
      <div class="hover:bg-base-200 rounded px-1 -ml-1 transition-colors">
        <%= form.date_field :due_date,
            class: "input input-ghost input-xs w-full font-normal focus:bg-base-200 focus:outline-none h-8 min-h-0 pl-1 text-left cursor-pointer" %>
      </div>

      <%# --- DIVIDER --- %>
      <div class="col-span-2 border-t border-base-200 my-2"></div>

      <%# --- READ ONLY: Creator --- %>
      <div class="flex items-center gap-2 text-base-content/60 py-1.5">
        <span class="material-symbols-outlined text-[18px]">account_circle</span>
        <span>Creator</span>
      </div>
      <div class="px-1 py-1.5 text-base-content truncate">
        <%# Use safe navigation in case creator is deleted %>
        <%= article.creator&.full_name || "Unknown" %>
      </div>

      <%# --- READ ONLY: Created At --- %>
      <div class="flex items-center gap-2 text-base-content/60 py-1.5">
        <span class="material-symbols-outlined text-[18px]">schedule</span>
        <span>Created</span>
      </div>
      <div class="px-1 py-1.5 text-base-content text-xs">
        <%= article.created_at.strftime("%b %d, %Y %I:%M %p") %>
      </div>

       <%# --- READ ONLY: Updated At --- %>
      <div class="flex items-center gap-2 text-base-content/60 py-1.5">
        <span class="material-symbols-outlined text-[18px]">update</span>
        <span>Updated</span>
      </div>
      <div class="px-1 py-1.5 text-base-content text-xs">
        <%= article.updated_at.strftime("%b %d, %Y %I:%M %p") %>
      </div>

    </div>

    <!-- Hidden submit button for non-JS fallback or explicit save if desired -->
    <noscript>
        <button class="btn btn-primary btn-sm mt-4 w-full">Update Properties</button>
    </noscript>
  <% end %>
</div>