<input type="radio" name="article_metadata" role="tab" class="tab" aria-label="Properties" checked />
<div role="tabpanel" class="tab-content rounded-box p-4 mt-6">

  <%= form_with model: article,
      url: app_article_path(article),
      method: :patch,
      class: "space-y-1",
      data: { controller: "autosave", action: "change->autosave#submit" } do |form| %>

    <!-- GRID CONTAINER -->
    <div class="grid grid-cols-[140px_1fr] items-center gap-y-1 text-sm">

      <%# --- 1. CATEGORY (Association) --- %>
      <div class="flex items-center gap-2 text-base-content/60 py-1.5">
        <span class="material-symbols-outlined text-[18px]">category</span>
        <span>Category</span>
      </div>
      <div class="hover:bg-base-200 rounded px-1 -ml-1 transition-colors font-bold">
        <%= form.collection_select :category_id,
            Category.all, :id, :name,
            { include_blank: "No Category" },
            class: "select select-ghost w-full font-semibold pl-1 hover:cursor-pointer",
            onchange: "this.form.requestSubmit();" %>
      </div>

      <%# --- DIVIDER --- %>
      <div class="col-span-2 divider"></div>

      <%# --- 3. writer (User Association) --- %>
      <%= render "app/articles/properties/user_property",
            form: form,
            attribute: :writer_id,
            label: "Writer",
            icon: "article_person",
            collection: User.all %>

      <%# --- 3. REVIEWER (User Association) --- %>
      <%= render "app/articles/properties/user_property",
            form: form,
            attribute: :reviewer_id,
            label: "Reviewer",
            icon: "person_check",
            collection: User.all %>

      <%# --- DIVIDER --- %>
      <div class="col-span-2 divider"></div>

      <%# --- 1. STATUS (Enum) --- %>
      <%= render "app/articles/properties/enum_selector",
          form: form,
          article: article,
          attribute: :status,
          label: "Status",
          icon: "dataset",
          include_blank: false,
          options: Article.statuses.keys.map { |k| [k.humanize, k] },
          color_map: {
            'published' => 'badge-success text-success-content',
            'in_review' => 'badge-warning text-warning-content',
            'archived'  => 'badge-neutral text-neutral-content',
            'draft'     => 'badge-info',
          } %>

      <%# --- 2. PRIORITY (Enum) --- %>
      <%= render "app/articles/properties/enum_selector",
          form: form,
          article: article,
          attribute: :priority,
          label: "Priority",
          icon: "flag",
          include_blank: "Empty",
          options: Article.priorities.keys.map { |k| [k.humanize, k] },
          color_map: {
            'high'   => 'badge-error text-error-content',
            'medium' => 'badge-warning text-warning-content',
            'low'    => 'badge-ghost text-base-content'
          } %>

      <%# --- 3. DUE DATE --- %>
      <div class="flex items-center gap-2 text-base-content/60 py-1.5">
        <span class="material-symbols-outlined text-[18px]">calendar_today</span>
        <span>Due Date</span>
      </div>
      <div class="hover:bg-base-200 rounded px-1 -ml-1 transition-colors">
        <%= form.date_field :due_date,
            class: "input input-ghost input-xs w-full font-normal focus:bg-base-200 focus:outline-none h-8 min-h-0 pl-1 text-left cursor-pointer" %>
      </div>

      <%# --- DIVIDER --- %>
      <div class="col-span-2 divider"></div>

      <%# --- READ ONLY: Creator --- %>
      <%= render "app/articles/properties/user_property",
            form: form,
            attribute: :creator_id,
            label: "Creator",
            icon: "account_circle",
            readonly: true
            %>

      <%# --- READ ONLY: Created At --- %>
      <div class="flex items-center gap-2 text-base-content/60 py-1.5">
        <span class="material-symbols-outlined text-[18px]">schedule</span>
        <span>Created</span>
      </div>
      <div class="px-1 py-1.5 text-base-content text-xs">
        <%= article.created_at.strftime("%b %d, %Y %I:%M %p") %>
      </div>

       <%# --- READ ONLY: Updated At --- %>
      <div class="flex items-center gap-2 text-base-content/60 py-1.5">
        <span class="material-symbols-outlined text-[18px]">update</span>
        <span>Updated</span>
      </div>
      <div class="px-1 py-1.5 text-base-content text-xs">
        <%= article.updated_at.strftime("%b %d, %Y %I:%M %p") %>
      </div>

    </div>
  <% end %>
</div>