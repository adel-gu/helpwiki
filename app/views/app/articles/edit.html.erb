<% content_for :title, "Editor" %>

<section
  data-controller="editor"
  data-editor-article-content="<%= @article.content.to_s %>"
  data-editor-url-value="<%= app_article_path(@article) %>">

  <%= render 'toolbar' %>

  <%= render "title", article: @article %>

  <div data-editor-target="content" class="mx-auto max-w-5xl"></div>
</section>